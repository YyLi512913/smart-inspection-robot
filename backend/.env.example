# Copy to backend/.env and fill local values. Do not commit the real .env.
MYSQL_URL=mysql+pymysql://inspection:CHANGE_ME@127.0.0.1:3306/robot_inspection?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6399/0
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=backend-consumer
ROBOT_IDS=robot1
AGENT_BASE_URL=https://api.deepseek.com
AGENT_API_KEY=
AGENT_MODEL=deepseek-chat
VLM_MODEL=deepseek-flash
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8010,http://localhost:8010,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_ALLOW_SETUP=true
